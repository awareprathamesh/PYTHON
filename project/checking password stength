password = input("enter password :- ")

has_uppercase =  False
has_lowercase = False
has_number = False

for ch in password:
    if ch.isupper():
        has_uppercase = True

    elif ch.islower():
        has_lowercase = True
 
    elif ch.isdigit():
        has_number = True

if len(password) >8 and has_number and has_lowercase and has_lowercase :
    print("you password is strong ")

else :
    print("your password is weak")


